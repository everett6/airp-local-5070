[Unit]
Description=Paper book: finish a scheduled run that a restart cut off (airp-local-5070, paper money only)

[Service]
Type=oneshot
WorkingDirectory=%h/airp-local-5070/backend
ExecStart=%h/airp-local-5070/backend/.venv/bin/python scripts/autorun.py resume
TimeoutStartSec=7h
Nice=5

[Install]
WantedBy=default.target
