# Copy to .env. Nothing here is a real credential.

ENV=development

# Optional — leave unset to run fully in-process with no external DB.
POSTGRES_DSN=
REDIS_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Local LLM endpoints (your two GPU PCs). See docs/LOCAL_SETUP.md.
# Leave a *_BASE_URL blank to fall back to a mock LLM client for that role.
LLM_REASONING_BASE_URL=http://192.168.1.50:11434
LLM_REASONING_MODEL=qwen2.5:14b-instruct-q4_K_M
LLM_EXTRACTION_BASE_URL=http://192.168.1.51:11434
LLM_EXTRACTION_MODEL=llama3.1:8b-instruct-q4_K_M

# Data providers — optional; falls back to Mock* connectors if unset.
MARKET_DATA_API_KEY=
SEC_EDGAR_USER_AGENT=AIRP Local you@example.com
FRED_API_KEY=
NEWS_API_KEY=
