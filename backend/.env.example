# Copy to backend/.env and fill in. backend/.env is gitignored.

# Required by SEC EDGAR fair-access rules for the sec_filings tool: "Name email@example.com"
SEC_USER_AGENT=

# Optional: enables the web_search tool (https://brave.com/search/api/)
BRAVE_SEARCH_API_KEY=

# Optional: override the User-Agent used for other web requests
WEB_USER_AGENT=

# Optional free price sources (app/data_ingestion/bars.py). Create these accounts yourself; the code never signs up.
# Alpaca free paper account, Basic plan (IEX feed):
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# Polygon.io / Massive free Stocks Basic key (5 calls a minute, end of day):
# POLYGON_API_KEY=
