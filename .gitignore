# Walk-forward simulation: downloaded market data (re-fetch with backend/scripts/fetch_prices.py;
# not redistributed) and the raw LLM response cache / logs
backend/data/*.csv
backend/results/*.log
backend/results/ui_*.log
backend/results/ui_*.pid
backend/results/live/
!backend/data/universe_*.csv
backend/results/forward/*.lock
backend/results/forward/*.log

# Kronos baseline: pinned clone + separate torch venv (scripts/setup_kronos.sh)
backend/third_party/
.venv-*
.venv

# earnings press-release texts: rebuildable with scripts/extract_events.py fetch, and large
backend/data/events/text/
backend/data/vq/
backend/results/forward/*/prices.parquet
backend/results/failures.jsonl
backend/results/forward/*_autodry/
backend/results/forward/logs/
backend/results/forward/AUTORUN_MODE
backend/data/intraday/

# Research tool cache (results/webcache/): tens of thousands of files; the 2,126 committed with the 2026-09-24 web
# backtest stay tracked for reproducibility, new ones are local only.
backend/results/webcache/
# Model-server and runner logs of research runs (GB-sized). Never results/forward/: autorun commits its logs.
backend/results/events/*.log
desktop/node_modules/
desktop/dist/
backend/results/desktop/

# long-term ratings saved mid-run (deleted once the cohort is in the ledger)
backend/results/forward/longterm/*.partial.jsonl
